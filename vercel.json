{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.mjs && node tools/og.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/menus", "destination": "/la-carte/", "permanent": true },
    { "source": "/menu", "destination": "/la-carte/", "permanent": true },
    { "source": "/menu-brunch", "destination": "/brunch-beaulieu-sur-mer/", "permanent": true },
    { "source": "/brunch", "destination": "/brunch-beaulieu-sur-mer/", "permanent": true },
    { "source": "/concept", "destination": "/restaurant-beaulieu-sur-mer/", "permanent": true },
    { "source": "/events", "destination": "/programme/", "permanent": true },
    { "source": "/evenements", "destination": "/programme/", "permanent": true },
    { "source": "/la-table-du-chef", "destination": "/programme/", "permanent": true },
    { "source": "/vente-emporter-traiteur", "destination": "/privatisation-evenements/", "permanent": true },
    { "source": "/privatisation", "destination": "/privatisation-evenements/", "permanent": true },
    { "source": "/politique-de-confidentialite", "destination": "/mentions-legales/", "permanent": true },
    { "source": "/cart", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(css|js|assets)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
